# ==============================================================
# .dockerignore — QuantTrade HFT Platform
# Keeps build contexts lean and avoids Windows path issues
# ==============================================================

# Git
.git/
.gitignore
.gitattributes

# IDE / editor files
.vscode/
.idea/
.gemini/
*.swp
*.swo

# ---------------------------------------------------------------
# Node / Frontend
# ---------------------------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
dist/

# ---------------------------------------------------------------
# Go binaries (local builds)
# ---------------------------------------------------------------
backend-go/server
backend-go/server.exe
backend-go/server.exe~

# ---------------------------------------------------------------
# C++ build outputs
# ---------------------------------------------------------------
exchange-sim/build/
exchange-sim/build_debug/
exchange-sim/exchange_sim
core-cpp/build/

# ---------------------------------------------------------------
# Python / ML
# ---------------------------------------------------------------
.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.mypy_cache/
.pytest_cache/
ml/data/
ml/models/
ml/artifacts/
ml/logs/
ml/__pycache__/
ml/**/__pycache__/
ml/*.pyc
ml/*.pkl
ml/*.h5
ml/*.onnx
ml/*.joblib
ml/inference/*_pb2.py
ml/inference/*_pb2_grpc.py

# ---------------------------------------------------------------
# Data files (large / runtime-generated)
# ---------------------------------------------------------------
data/ticks/
artifacts/
logs/
tmp/
*.parquet
*.csv
*.ckpt
*.pt
*.hdf5
*.tar.gz
*.zip

# ---------------------------------------------------------------
# Secrets / environment
# ---------------------------------------------------------------
.env
.env.*
*.pem
*.key

# ---------------------------------------------------------------
# Docs / scripts (not needed inside images)
# ---------------------------------------------------------------
docs/
scripts/
*.md
